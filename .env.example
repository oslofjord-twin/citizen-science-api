# Copy this file to .env and fill in your values
# For local dev: cp .env.development .env
# For production: cp .env.production .env

# Server
PORT=3000
NODE_ENV=development
BODY_LIMIT=30mb

# Redis (optional)
REDIS_URL=redis://localhost:6379
DISABLE_REDIS=false

# Postgres
DATABASE_URL=postgresql://localhost:5432/citizen_science

# Object Storage (S3 API)
# Development: use MinIO (see .env.development)
# Production: use NREC (see .env.production)
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
S3_PRESIGN_EXPIRES_SECONDS=300

# Secchi upload constraints
SECCHI_MAX_UPLOAD_BYTES=26214400

# Secchi prediction (optional - for local ML model testing)
SECCHI_PYTHON=python3
SECCHI_PREDICT_SCRIPT=/path/to/sort/predict.py
SECCHI_MODEL_DIR=/path/to/sort/models
SECCHI_DEVICE=cpu
SECCHI_TIMEOUT_MS=30000
